file(GLOB_RECURSE CLIENT_FILES "${ROOT}/include/auction/client/*.h" "${ROOT}/src/client/*.cpp" "${ROOT}/include/auction/presentation/*.h" "${ROOT}/src/presentation/*.cpp")
list(APPEND CLIENT_FILES "${ROOT}/app/client_main.cpp")
foreach(PATH IN LISTS CLIENT_FILES)
    file(READ "${PATH}" SOURCE)
    string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"]+[>\"]" INCLUDES "${SOURCE}")
    foreach(INCLUDE IN LISTS INCLUDES)
        if(INCLUDE MATCHES "auction/(application|infrastructure|infrastructure_qt|domain)/")
            if(NOT INCLUDE MATCHES "auction/(application/(Dtos|Commands)\\.h|domain/(values/[^>\"]+|events/AuctionEvent\\.h|ports/IClock\\.h|AuctionConfig\\.h))[>\"]")
                message(FATAL_ERROR "Client layering violation in ${PATH}: ${INCLUDE}")
            endif()
        endif()
    endforeach()
    if(SOURCE MATCHES "AuctionEngine::|AuctionEngine[ \t]*[&*]")
        message(FATAL_ERROR "Client engine dependency in ${PATH}")
    endif()
endforeach()
message(STATUS "Client layering is valid")
